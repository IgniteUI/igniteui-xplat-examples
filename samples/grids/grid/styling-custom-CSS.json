{
  "note": "example of applying custom CSS properties to Grid Cell Selection",
  "export": true,
  "skipAlterDataCasing": true,
  "onInit": [ "WebGridCellSelectionStyleWithCustomCSS" ],
  "descriptions": {
    "content": {
      "type": "WebGrid",
      "dataRef": "EnergyGlobalDemand",
      "id": "grid",
      "name": "grid",
      "cellSelection": "Multiple",
      "columnSelection": "Multiple",
      "autoGenerate": false,
      "columnList": [
        {
          "type": "WebColumn",
          "field": "Category",
          "header": "Category",
          "selectable": true
        },
        {
          "type": "WebColumn",
          "field": "Value",
          "header": "Market Share",
          "selectable": true
        },
        {
          "type": "WebColumn",
          "field": "Summary",
          "header": "Summary",
          "selectable": false
        }
      ]
    }
  },
  "modules": [
    "grids/WebGridModule"
  ]
}