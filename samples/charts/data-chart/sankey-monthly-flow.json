{
  "strings": {
    "title": "Budget Flow by Month"
  },
  "hasAnimations": true,
  "skipAlterDataCasing": true,
  "descriptions": {
    "editor": {
      "type": "PropertyEditorPanel",
      "name": "editor",
      "componentRendererRef": "renderer",
      "targetRef": "chart",
      "descriptionType": "DataChart",
      "isHorizontal": true,
      "isWrappingEnabled": true,
      "properties": [
        {
          "type": "PropertyEditorPropertyDescription",
          "propertyPath": "MonthHandler",
          "name": "MonthEditor",
          "label": "Month",
          "shouldOverrideDefaultEditor": true,
          "valueType": "EnumValue",
          "dropDownNames": [
            "July",
            "August",
            "September"
          ],
          "dropDownValues": [
            "July",
            "August",
            "September"
          ],
          "primitiveValue": "July",
          "changedRef": "EditorChangeSankeyMonth"
        }
      ]
    },
    "content": {
      "type": "DataChart",
      "name": "chart",
      "isHorizontalZoomEnabled": false,
      "isVerticalZoomEnabled": false,
      "highlightingMode": "FadeOthersSpecific",
      "highlightingBehavior": "DirectlyOver",
      "plotAreaMarginRight": 120,
      "animateSeriesWhenAxisRangeChanges": true,
      "axes": [
        {
          "type": "CategoryXAxis",
          "name": "xAxis",
          "dataSourceRef": "SankeyBudgetStages",
          "label": "Stage",
          "areLabelsVisible": false,
          "tickLength": 0,
          "stroke": "Transparent",
          "majorStroke": "Transparent"
        },
        {
          "type": "NumericYAxis",
          "name": "yAxis",
          "areLabelsVisible": false,
          "tickLength": 0,
          "stroke": "Transparent",
          "majorStroke": "Transparent"
        }
      ],
      "series": [
        {
          "type": "SankeySeries",
          "name": "sankey",
          "title": "Budget",
          "xAxisRef": "xAxis",
          "yAxisRef": "yAxis",
          "dataSourceRef": "SankeyBudgetNodes",
          "nodeIdMemberPath": "Id",
          "nodeLabelMemberPath": "Label",
          "nodeLayerMemberPath": "Layer",
          "linkSourceRef": "SankeyBudgetMonths",
          "linkIdMemberPath": "Id",
          "linkSourceMemberPath": "Source",
          "linkTargetMemberPath": "Target",
          "linkValueMemberPath": "July",
          "useItemWiseColors": true,
          "thickness": 0,
          "areaFillOpacity": 0.7,
          "isTransitionInEnabled": true,
          "shouldAnimateOnDataSourceSwap": true,
          "transitionDuration": 1000
        },
        {
          "type": "CalloutLayer",
          "name": "nodeLabels",
          "targetSeriesRef": "sankey",
          "isAutoCalloutBehaviorEnabled": true,
          "useValueForAutoCalloutLabels": false,
          "useItemColorForOutline": true,
          "calloutStrokeThickness": 2,
          "calloutTextColor": "Black",
          "calloutBackground": "White"
        },
        {
          "type": "DataToolTipLayer",
          "name": "tooltips"
        }
      ]
    }
  },
  "modules": [
    "withDescriptions",
    "layouts/PropertyEditorPanelModule",
    "charts/DataChartCoreModule",
    "charts/DataChartCategoryCoreModule",
    "charts/DataChartFlowModule",
    "charts/DataChartInteractivityModule",
    "charts/DataChartAnnotationModule",
    "charts/AnnotationLayerProxyModule"
  ]
}
