        { "type": "PropertyEditorPropertyDescription", "propertyPath": "PanRight", "label": "", "valueType": "Button", "primitiveValue": "Pan Right", "buttonClickedRef": "EditorButtonChartPanRight" },
        { "type": "PropertyEditorPropertyDescription", "propertyPath": "ZoomIn", "label": "", "valueType": "Button", "primitiveValue": "Zoom In", "buttonClickedRef": "EditorButtonChartZoomIn" },
        { "type": "PropertyEditorPropertyDescription", "propertyPath": "ZoomOut", "label": "", "valueType": "Button", "primitiveValue": "Zoom Out", "buttonClickedRef": "EditorButtonChartZoomOut" },
