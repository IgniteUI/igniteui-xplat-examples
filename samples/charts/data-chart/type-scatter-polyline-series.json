{
  "strings": {
    "legendTitle": "Airplane Seating Chart (Polylines)"
  },
  "descriptions": {
    "content": {
      "type": "DataChart",
      "name": "chart",
      "isHorizontalZoomEnabled": true,
      "isVerticalZoomEnabled": true,
      "axes": [
        {
          "type": "NumericXAxis",
          "name": "xAxis",
          "minimumValue": -1000,
          "maximumValue": 1000,
          "interval": 200
        },
        {
          "type": "NumericYAxis",
          "name": "yAxis",
          "minimumValue": -600,
          "maximumValue": 600,
          "interval": 200
        }
      ],
      "series": [
        {
          "type": "ScatterPolylineSeries",
          "name": "airplaneShapeSeries",
          "xAxisRef": "xAxis",
          "yAxisRef": "yAxis",
          "dataSourceRef": "AirplaneShape",
          "shapeMemberPath": "Points",
          "title": "Airplane Shape",
          "thickness": 1,
          "brush": "Black",
          "outline": "Black"
        },
        {
          "type": "ScatterPolylineSeries",
          "name": "airplaneSeatSeries",
          "xAxisRef": "xAxis",
          "yAxisRef": "yAxis",
          "dataSourceRef": "AirplaneSeats",
          "shapeMemberPath": "Points",
          "title": "Airplane Seats",
          "showDefaultTooltip": false,
          "tooltipTemplateRef": "DataChartAirplaneSeatTooltipTemplate",
          "assigningShapeStyleRef": "AirplaneSeatStrokeStyling"
        }
      ]
    }
  },
  "modules": [
    "charts/DataChartCoreModule",
    "charts/DataChartShapeCoreModule",
    "charts/DataChartShapeModule",
    "charts/DataChartInteractivityModule",
    "charts/ScatterPolylineSeriesModule"
  ]
}
