{
  "strings": {
    "title": "Styled Sankey Flow"
  },
  "hasAnimations": true,
  "descriptions": {
    "content": {
      "type": "DataChart",
      "name": "chart",
      "isHorizontalZoomEnabled": false,
      "isVerticalZoomEnabled": false,
      "highlightingMode": "FadeOthersSpecific",
      "highlightingBehavior": "DirectlyOver",
      "axes": [
        {
          "type": "CategoryXAxis",
          "name": "xAxis",
          "dataSourceRef": "SankeyIncomeStages",
          "label": "Stage",
          "areLabelsVisible": false,
          "tickLength": 0,
          "stroke": "Transparent",
          "majorStroke": "Transparent"
        },
        {
          "type": "NumericYAxis",
          "name": "yAxis",
          "areLabelsVisible": false,
          "tickLength": 0,
          "stroke": "Transparent",
          "majorStroke": "Transparent"
        }
      ],
      "series": [
        {
          "type": "SankeySeries",
          "name": "sankey",
          "title": "Budget Flow",
          "xAxisRef": "xAxis",
          "yAxisRef": "yAxis",
          "linkSourceRef": "SankeyIncomeFlow",
          "linkSourceMemberPath": "Source",
          "linkTargetMemberPath": "Target",
          "linkValueMemberPath": "Value",
          "nodeGap": 250,
          "thickness": 0,
          "areaFillOpacity": 0.7,
          "radiusX": 4,
          "radiusY": 4,
          "ribbonShape": "UniformWidth",
          "highlightScope": "ConnectedFlow",
          "isTransitionInEnabled": true,
          "styleMappings": [
            {
              "type": "FlowStyleMapping",
              "nodeLabel": "Savings",
              "fill": "#2E7D32",
              "outline": "#2E7D32"
            },
            {
              "type": "FlowStyleMapping",
              "nodeLabel": "Housing",
              "fill": "#1565C0",
              "outline": "#1565C0"
            },
            {
              "type": "FlowStyleMapping",
              "nodeLabel": "Discretionary",
              "fill": "#EF6C00",
              "outline": "#EF6C00"
            },
            {
              "type": "FlowStyleMapping",
              "minimumValue": 9000,
              "maximumValue": 10000,
              "fill": "#6A1B9A",
              "outline": "#6A1B9A"
            }
          ],
          "useItemWiseColors": true
        },
        {
          "type": "DataToolTipLayer",
          "name": "tooltips"
        }
      ]
    }
  },
  "modules": [
    "charts/DataChartCoreModule",
    "charts/DataChartCategoryCoreModule",
    "charts/DataChartFlowModule",
    "charts/DataChartInteractivityModule",
    "charts/DataChartAnnotationModule"
  ]
}
