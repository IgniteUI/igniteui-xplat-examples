//begin template
@using IgniteUI.Blazor.Controls

@code {
    //begin content
    public RenderFragment<IgbDataContext> CategoryChartTooltipTemplate = (context) => {
        return @<div class="tooltipVertical">
            <div class="tooltipTitle">Franchise: @context.Item.Franchise</div>
            <div class="tooltipLbl">Revenue of All Movies: @context.Item.TotalRevenue</div>
            <div class="tooltipLbl">Highest Grossing Movie: $@context.Item.HighestGrossing</div>
        </div>;
    };
    //end content
}
//end template
