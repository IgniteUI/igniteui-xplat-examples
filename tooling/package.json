{
  "name": "@igniteui/xplat-codegen-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral Node tooling for Ignite UI cross-platform sample and documentation snippet generation.",
  "bin": {
    "xplat-codegen": "./src/cli.mjs"
  },
  "exports": {
    ".": "./dist/codegen-api.cjs",
    "./snippet-emit": "./src/snippet-emit.mjs"
  },
  "scripts": {
    "build": "esbuild src/codegen-api.ts --bundle --platform=node --format=cjs --outfile=dist/codegen-api.cjs --log-level=warning",
    "check": "npm run build && node src/cli.mjs check",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "igniteui-angular": "^22.0.0",
    "igniteui-angular-charts": "^22.0.0",
    "igniteui-angular-core": "^22.0.0",
    "igniteui-angular-data-grids": "^22.0.0",
    "igniteui-angular-gauges": "^22.0.0",
    "igniteui-angular-layouts": "^22.0.0",
    "igniteui-angular-maps": "^22.0.0",
    "igniteui-react": "^19.6.2",
    "igniteui-react-charts": "^19.6.0-beta.2",
    "igniteui-react-core": "^19.6.0-beta.2",
    "igniteui-react-data-grids": "^19.6.0-beta.2",
    "igniteui-react-datasources": "^19.6.0-beta.2",
    "igniteui-react-gauges": "^19.6.0-beta.2",
    "igniteui-react-grids": "^19.6.2",
    "igniteui-react-layouts": "^19.6.0-beta.2",
    "igniteui-react-maps": "^19.6.0-beta.2",
    "igniteui-webcomponents-core": "7.1.1-beta.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "igniteui-webcomponents": "^7.1.1",
    "igniteui-webcomponents-charts": "7.1.1-beta.12",
    "igniteui-webcomponents-data-grids": "7.1.1-beta.12",
    "igniteui-webcomponents-datasources": "7.1.1-beta.12",
    "igniteui-webcomponents-gauges": "7.1.1-beta.12",
    "igniteui-webcomponents-grids": "7.2.0-beta.1",
    "igniteui-webcomponents-layouts": "7.1.1-beta.12",
    "igniteui-webcomponents-maps": "7.1.1-beta.12",
    "lit": "^3.3.3",
    "typescript": "^5.9.3"
  }
}
